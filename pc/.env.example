# PC端环境配置示例
# 请复制此文件为 .env.development 或 .env.production 并修改相应配置

# 基础URL配置
NUXT_BASE_URL=/

# API配置
NUXT_API_URL=http://localhost:8088  # 你的后端API地址
NUXT_API_PREFIX=/dev-api            # API前缀，根据后端配置调整

# 客户端标识
NUXT_CLIENT=pc

# 版本信息
NUXT_VERSION=1.0.0

# 是否启用SSR
NUXT_SSR=false

# 调试模式
NUXT_DEBUG=true